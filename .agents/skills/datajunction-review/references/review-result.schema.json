{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:datajunction:review-result:v2",
  "title": "DataJunction automated PR review result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repository", "pr_number", "head_sha", "status", "context_digest", "resolved_thread_ids", "verdict", "required_actions", "test_gaps", "summary", "findings", "limitations"],
  "properties": {
    "schema_version": {"const": 2},
    "repository": {"enum": ["DataJunction/dj", "robinld/dj"]},
    "pr_number": {"type": "integer", "minimum": 1},
    "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "status": {"enum": ["complete", "incomplete"]},
    "context_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "resolved_thread_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "verdict": {"enum": ["approve", "request_changes", "block"]},
    "required_actions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "test_gaps": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "summary": {"type": "string", "minLength": 1},
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "confidence", "title", "path", "line", "body", "existing_thread_id"],
        "properties": {
          "severity": {"enum": ["P0", "P1", "P2", "P3"]},
          "confidence": {"enum": ["high", "medium", "low"]},
          "title": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "line": {"type": ["integer", "null"], "minimum": 1},
          "body": {"type": "string", "minLength": 1},
          "existing_thread_id": {"type": ["string", "null"], "minLength": 1}
        }
      }
    }
  },
  "if": {"properties": {"status": {"const": "incomplete"}}},
  "then": {"properties": {"limitations": {"minItems": 1}, "verdict": {"enum": ["request_changes", "block"]}}}
}
